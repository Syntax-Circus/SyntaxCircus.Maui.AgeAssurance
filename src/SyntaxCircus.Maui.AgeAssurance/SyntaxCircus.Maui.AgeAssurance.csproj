<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <PackageId>SyntaxCircus.Maui.AgeAssurance</PackageId>
    <Title>SyntaxCircus MAUI Age Assurance</Title>
    <Description>Platform age signals for MAUI apps on iOS (Apple Declared Age Range) and Android (Google Play Age Signals), normalized into one policy-free result model: status, eligibility, restriction, approval and regulatory requirements. Includes a restriction state machine and a fake provider for tests. No app-specific age policy, UI, legal text or persistence.</Description>
    <Authors>Syntax Circus LLC</Authors>
    <Company>Syntax Circus LLC</Company>
    <Copyright>Copyright © Syntax Circus LLC</Copyright>
    <PackageTags>maui;age-assurance;age-signals;declared-age-range;play-age-signals;compliance</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Syntax-Circus/SyntaxCircus.Maui.AgeAssurance</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Syntax-Circus/SyntaxCircus.Maui.AgeAssurance</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="GitVersion.MsBuild" PrivateAssets="all" />
  </ItemGroup>
  <!-- Android: the Play Age Signals binding is a private project whose assembly ships inside this package
       (see _IncludeBindingAssemblies); its Java dependencies flow to consumers as normal NuGet dependencies. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <ProjectReference Include="..\SyntaxCircus.Maui.AgeAssurance.Android.Binding\SyntaxCircus.Maui.AgeAssurance.Android.Binding.csproj" PrivateAssets="all" />
    <PackageReference Include="Xamarin.GooglePlayServices.Tasks" />
    <PackageReference Include="Xamarin.Google.Android.Play.Core.Common" />
  </ItemGroup>
  <!-- iOS: the Declared Age Range binding (Swift shim as an embedded xcframework) is private and ships as lib/<tfm>/ dll + resources.zip. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <ProjectReference Include="..\SyntaxCircus.Maui.AgeAssurance.iOS.Binding\SyntaxCircus.Maui.AgeAssurance.iOS.Binding.csproj" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_IncludeBindingAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_IncludeBindingNativeResources</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <!-- Native payloads the app build picks up from beside the binding dll:
       - iOS: the xcframework, in <assembly>.resources.zip.
       - Android: the Play Age Signals AAR (Java classes, resources and the consent activity's manifest entry); the
         binding dll holds only the C# wrappers. BuildOutputInPackage would drop it (.aar is not an allowed extension). -->
  <Target Name="_IncludeBindingNativeResources">
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
      <TfmSpecificPackageFile Include="../SyntaxCircus.Maui.AgeAssurance.iOS.Binding/bin/$(Configuration)/$(TargetFramework)/SyntaxCircus.Maui.AgeAssurance.iOS.Binding.resources.zip" PackagePath="lib/$(TargetFramework)$(TargetPlatformVersion)/" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
      <TfmSpecificPackageFile Include="../SyntaxCircus.Maui.AgeAssurance.Android.Binding/bin/$(Configuration)/$(TargetFramework)/*.aar" PackagePath="lib/$(TargetFramework)$(TargetPlatformVersion)/" />
    </ItemGroup>
  </Target>
  <Target Name="_IncludeBindingAssemblies">
    <ItemGroup>
      <!-- Fixed layout instead of resolving the references: a no-build pack must not invoke their Build. The
           referenced projects were built with the same Configuration and target framework as this one. -->
      <_BindingAssembly Include="../SyntaxCircus.Maui.AgeAssurance.Android.Binding/bin/$(Configuration)/$(TargetFramework)/SyntaxCircus.Maui.AgeAssurance.Android.Binding.dll" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
      <_BindingAssembly Include="../SyntaxCircus.Maui.AgeAssurance.iOS.Binding/bin/$(Configuration)/$(TargetFramework)/SyntaxCircus.Maui.AgeAssurance.iOS.Binding.dll" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
      <BuildOutputInPackage Include="@(_BindingAssembly)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SyntaxCircus.Maui.AgeAssurance.Tests" />
  </ItemGroup>
</Project>
